# Database Configuration
DATABASE_URL=postgresql+asyncpg://debug_user:debug_password@localhost:5432/debugging_agent
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# LLM Configuration (OpenAI)
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4
MODEL_TEMPERATURE=0.1
MAX_TOKENS=8192

# Agent Configuration
MAX_AGENT_ITERATIONS=5
AGENT_TIMEOUT=300
ENABLE_CODE_EXECUTION=true

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
UPLOAD_MAX_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=["py", "ts", "tsx", "js", "jsx", "java", "cs", "cpp", "c", "go", "rs", "rb"]

# Logging
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Enable features
ENABLE_AUTO_FIXES=true
ENABLE_SECURITY_ANALYSIS=true
ENABLE_PERFORMANCE_ANALYSIS=true

# Redis Configuration (for Celery task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Celery Configuration
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_TIME_LIMIT=1800  # 30 minutes
CELERY_TASK_SOFT_TIME_LIMIT=1500  # 25 minutes
CELERY_WORKER_CONCURRENCY=4

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# External Services
GITHUB_TOKEN=  # Optional: for repository integration
SLACK_WEBHOOK_URL=  # Optional: for notifications

# Email Configuration (optional)
SMTP_HOST=  # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=  # your-email@gmail.com
SMTP_PASSWORD=  # your-app-password
SMTP_FROM=  # noreply@debugging-agent.com

# Storage Configuration
STORAGE_TYPE=local  # local, s3, gcs
STORAGE_PATH=./storage/results

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Error Tracking (optional)
SENTRY_DSN=  # https://key@sentry.io/123456

# Analytics (optional)
MIXPANEL_TOKEN=
POSTHOG_API_KEY=
